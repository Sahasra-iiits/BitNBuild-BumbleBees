# ==============================================================================
# SynapseLab Backend — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL=postgresql://synapselab:synapselab_dev@localhost:5432/synapselab_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (CHANGE IN PRODUCTION)
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars-long!!
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars-long!!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookie Configuration
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_HTTP_ONLY=true

# CSRF Secret (CHANGE IN PRODUCTION)
CSRF_SECRET=change-me-csrf-secret-at-least-32-chars-long!!

# Object Storage (S3-compatible, e.g., MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=synapselab-assets
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_GENERAL=100
RATE_LIMIT_MAX_AUTH=20
RATE_LIMIT_MAX_EVENTS=500

# Export Configuration
EXPORT_DIR=./exports
EXPORT_EXPIRY_HOURS=24

# Application
APP_NAME=SynapseLab
APP_URL=http://localhost:4000
